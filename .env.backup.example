# Copie para .env.backup e execute chmod 600 .env.backup antes de preencher
# Credenciais administrativas, nunca usar prefixo VITE_ ou publicar este arquivo
BACKUP_DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_SESSION_POOLER:5432/postgres
BACKUP_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Secret key ou service_role, exclusiva do comando local
BACKUP_STORAGE_KEY=SUBSTITUA_LOCALMENTE

# Docker executa ferramentas oficiais PostgreSQL 17, Linux com --network host
BACKUP_PG_TOOLS=docker
BACKUP_POSTGRES_IMAGE=public.ecr.aws/supabase/postgres:17.11.0.004
# Alternativa: native, com pg_dump, pg_dumpall e psql compatíveis no PATH
